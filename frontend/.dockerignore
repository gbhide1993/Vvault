# ============================================================
#  VVAULT — .dockerignore
#  Files excluded from the Docker build context
#  CRITICAL: keeps secrets and dev files out of production image
# ============================================================

# ── SECRETS — never include these ────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
.vvault-license
*.vvault-license

# ── GIT ──────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ── PYTHON CACHE ─────────────────────────────────────────────
__pycache__
*.pyc
*.pyo
*.pyd
*.pycache
.pytest_cache
.mypy_cache
.ruff_cache

# ── VIRTUAL ENVIRONMENTS ─────────────────────────────────────
venv
.venv
env
.env
virtualenv

# ── DEVELOPMENT FILES ─────────────────────────────────────────
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db
desktop.ini

# ── DOCKER FILES (not needed inside image) ───────────────────
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# ── CERTIFICATES (generated locally, not in image) ───────────
certs/

# ── CUSTOMER INSTALLER FILES ─────────────────────────────────
install.bat
install.sh
install-ghcr.bat
install-ghcr.sh
build-and-push.sh
README.txt
LICENSE.txt

# ── TESTS ────────────────────────────────────────────────────
tests/
test_*
*_test.py
pytest.ini
setup.cfg
.coverage
htmlcov/

# ── DOCS AND NON-ESSENTIAL ───────────────────────────────────
docs/
*.md
!app/README.md

# ── FRONTEND (built separately) ──────────────────────────────
frontend/

# ── DATABASE INIT (customers get this via volume) ────────────
# db/ is kept — backend may need schema reference

# ── IDE FILES ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user
